# Pitstop – Konfiguration
# Kopieren nach .env (cp .env-example .env) und anpassen. Die .env gehört nie in Git.
# Kommentare immer in eigene Zeilen schreiben, nicht hinter einen Wert.

# --- Pflicht -----------------------------------------------------------------

# Passwort der Datenbank. Lang und zufällig wählen, z. B. mit: openssl rand -hex 24
# Wirkt nur beim allerersten Start (leerer Ordner ./db), siehe README.
POSTGRES_PASSWORD=

# Erster Admin. Wird nur angelegt, solange es noch keinen Benutzer gibt.
# Das Passwort (mindestens 12 Zeichen) muss beim ersten Anmelden geändert werden.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresse, unter der Pitstop im Browser erreichbar ist.
# Beginnt sie mit https://, setzt Pitstop sichere Cookies (dann nur per HTTPS aufrufen).
PUBLIC_URL=http://localhost:8080

# --- Optional ----------------------------------------------------------------

# Port auf dem Server
PITSTOP_PORT=8080

# Zeitzone für Datum, "heute" und Logs
TZ=Europe/Berlin

# true = beim ersten Start Demo-Daten einspielen und Ein-Klick-Anmeldung anbieten.
# Nicht für echte Daten verwenden!
DEMO_MODE=false

# Datenbank-Benutzer und -Name
POSTGRES_USER=pitstop
POSTGRES_DB=pitstop

# debug, info, warn oder error
LOG_LEVEL=info

# Anmeldung mit Discord (optional). Unter https://discord.com/developers/applications eine Anwendung anlegen,
# bei OAuth2 als Redirect "<PUBLIC_URL>/api/auth/discord/callback" eintragen und Client-ID und Secret hier setzen.
# Leer = ohne Discord-Anmeldung. Discord legt keine Konten an; jede Person verknüpft unter "Mein Konto".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
